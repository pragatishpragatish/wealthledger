# Supabase
# Project URL from: Settings → API (or Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# IMPORTANT: the variable name must be NEXT_PUBLIC_SUPABASE_ANON_KEY
# (even if you paste a Publishable key). Do not rename it to PUBLISHABLE_KEY.
#
# Use EITHER value:
#   - Publishable key: Settings → API Keys → Publishable (sb_publishable_...)
#   - Legacy anon key: Settings → API Keys → Legacy → anon (eyJ...)
# Do NOT use secret / service_role keys here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / auto investment prices (server only — never expose to the browser)
# Service role: Settings → API Keys → service_role (secret). Used by weekday price cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret for /api/cron/update-investment-prices (also set in Vercel env for Cron).
CRON_SECRET=generate-a-long-random-string
